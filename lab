#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"; cd "$ROOT"
cmd="${1:-help}"; shift || true

IMAGE="observability-lab-python:1.0"
LGTM_IMAGE="grafana/otel-lgtm:0.29.0"
# --progress quiet keeps "Container xxx Created" noise out of every command's output.
compose=(docker compose --progress quiet -f "$ROOT/workshop/compose.yaml")

require_docker(){
  if ! docker info >/dev/null 2>&1; then
    echo "ERROR: cannot reach the Docker daemon." >&2
    echo "Start Docker Desktop, wait for it to finish starting, then try again." >&2
    return 1
  fi
}
require_images(){
  require_docker
  local missing=()
  docker image inspect "$IMAGE" >/dev/null 2>&1 || missing+=("$IMAGE")
  docker image inspect "$LGTM_IMAGE" >/dev/null 2>&1 || missing+=("$LGTM_IMAGE")
  if (( ${#missing[@]} )); then
    echo "ERROR: missing Docker image(s): ${missing[*]}" >&2
    echo "Run './lab setup' once while online, or './lab import-images <archive.tar>' offline." >&2
    return 1
  fi
}
wait_health(){
  local deadline=$((SECONDS+180))
  while (( SECONDS < deadline )); do
    if "${compose[@]}" exec -T checkout python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health',timeout=2)" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  echo "ERROR: services did not become ready" >&2; "${compose[@]}" ps; return 1
}
restore(){
  local cp="$1"
  cp "workshop/checkpoints/$cp/checkout.py" services/checkout/app/checkout.py
  cp "workshop/checkpoints/$cp/validation.py" services/payment/app/validation.py
}
run_tools(){ "${compose[@]}" run --rm --no-deps -T tools "$@"; }
case "$cmd" in
  setup)
    docker pull "$LGTM_IMAGE"
    docker build -t "$IMAGE" -f workshop/docker/python.Dockerfile .
    echo "SETUP COMPLETE: run './lab start'"
    ;;
  start)
    require_images
    mkdir -p .lab-state
    echo "Starting the lab stack. The first run pulls nothing but unpacks images,"
    echo "so it can take two to three minutes. Later runs take a few seconds."
    "${compose[@]}" up -d --no-build --pull never lgtm inventory payment checkout
    echo "Services created. Waiting for checkout to report healthy..."
    wait_health
    echo "STARTED: run './lab ready', then './lab guide'"
    ;;
  ready)
    wait_health
    run_tools python /workspace/workshop/scripts/check_ready.py
    run_tools python /workspace/workshop/scripts/check_grafana.py
    ;;
  restart-services)
    # The readiness markers are emitted once, at import. If a backend was not
    # accepting data yet, restarting the applications re-emits them.
    "${compose[@]}" restart inventory payment checkout
    wait_health
    echo "RESTARTED: run './lab ready' again"
    ;;
  traffic)
    run_tools python /workspace/workshop/traffic/generate.py "${1:-incident}"
    ;;
  check)
    signal="${1:?metrics|traces|logs required}"
    run_tools python "/workspace/workshop/scripts/check_${signal}.py"
    ;;
  recover)
    signal="${1:?metrics|traces|logs required}"
    case "$signal" in metrics) cp=1-metrics-complete;; traces) cp=2-traces-complete;; logs) cp=3-logs-complete;; *) exit 2;; esac
    restore "$cp"
    echo "Restored checkpoint $cp; waiting for hot reload..."
    sleep 3
    "${compose[@]}" up -d --no-build --pull never lgtm inventory payment checkout >/dev/null
    wait_health
    "$0" traffic incident >/dev/null
    "$0" check "$signal"
    ;;
  checkpoint)
    case "${1:?starter|metrics|traces|logs required}" in starter) cp=0-starter;; metrics) cp=1-metrics-complete;; traces) cp=2-traces-complete;; logs) cp=3-logs-complete;; *) exit 2;; esac
    restore "$cp"; echo "CHECKPOINT: $cp restored"
    ;;
  reset)
    restore 0-starter
    rm -rf .lab-state && mkdir -p .lab-state
    "${compose[@]}" down -v --remove-orphans >/dev/null 2>&1 || true
    echo "RESET: starter code and empty telemetry state restored"
    ;;
  test)
    run_tools sh -c 'cd /workspace && python -m unittest discover -s workshop/tests -t . -v'
    ;;
  links) run_tools python /workspace/workshop/scripts/links.py;;
  logs)
    # Participants need this when a paste stops a service reloading, and it
    # keeps Docker knowledge out of the guide.
    "${compose[@]}" logs --tail "${2:-20}" "${1:?checkout|inventory|payment required}"
    ;;
  guide)
    # The page is committed, so this works with the stack stopped and offline.
    doc="${1:-guide}"
    case "$doc" in guide) file=guide/guide.html;; worksheet) file=guide/worksheet.html;; *) echo "Usage: ./lab guide [guide|worksheet]" >&2; exit 2;; esac
    echo "Opening $file. Its Grafana buttons need './lab start' to be running."
    open "$ROOT/$file"
    ;;
  build-guide) run_tools python /workspace/workshop/scripts/build_guide.py;;
  validate-full) exec "$ROOT/workshop/scripts/validate_full.sh";;
  stop) "${compose[@]}" stop;;
  export-images) docker save -o "${1:-observability-lab-images.tar}" "$LGTM_IMAGE" "$IMAGE";;
  import-images) docker load -i "${1:?image archive required}";;
  *)
    cat <<'USAGE'
Usage: ./lab <command>

Setup
  setup                    Pull and build the pinned images (run once, online)
  export-images [FILE]     Save the pinned images to an archive
  import-images FILE       Load images from an archive (offline setup)

Running the lab
  start                    Start the stack
  ready                    Verify every backend is serving data
  guide [worksheet]        Open the lab guide (guide.html) in your browser
  links                    Print every prepared Grafana link
  traffic healthy|incident Generate a traffic profile
  check metrics|traces|logs Verify fresh evidence for one signal
  stop                     Stop containers, keep telemetry and code

If something goes wrong
  logs SERVICE [LINES]     Show a service's recent output (checkout|inventory|payment)
  ready                    Safe to re-run; backends can be slow to start
  restart-services         Re-emit readiness markers, then run 'ready' again
  recover metrics|traces|logs  Restore that checkpoint and re-verify
  checkpoint starter|metrics|traces|logs  Restore code only
  reset                    Restore starter code and delete telemetry

Maintenance
  test                     Run unit and contract tests in-container
  build-guide              Rebuild guide.html and worksheet.html from the Markdown
  validate-full            Validate the complete path end to end
USAGE
    ;;
esac
