{
  "uid": "checkout-overview",
  "title": "Checkout: detect and scope hidden failures",
  "tags": [
    "observability-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Every request returned HTTP 200. Runtime metrics are normal. Is checkout healthy?\n\n**HTTP 200 responses** is the *lowest* success rate in any 15-second window \u2014 the best case for transport. **Peak business failures** is the *highest* failure rate in any 15-second window \u2014 the worst case for the business outcome. A healthy service agrees with itself across both. For exact whole-checkout counts, read **Checkout outcomes by segment**."
      }
    },
    {
      "type": "stat",
      "title": "HTTP 200 responses",
      "description": "Lowest HTTP success rate in any 30s window. Transport-level health only: it says the API answered, not that checkout did its job.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate({__name__=~\"checkout_http_responses.*\",http_response_status_code=\"200\"}[15s])) / sum(rate({__name__=~\"checkout_http_responses.*\"}[15s]))",
          "legendFormat": "HTTP 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "min"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Peak business failures",
      "description": "Highest business-failure rate in any 30s window. 'or vector(0)' keeps the panel showing 0% during healthy traffic instead of dropping to No data.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate({__name__=~\"checkout_completed.*\",checkout_outcome!=\"success\"}[15s]) or vector(0)) / sum(rate({__name__=~\"checkout_completed.*\"}[15s]))",
          "legendFormat": "Business failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Checkout CPU",
      "description": "Process CPU for the checkout service. Normal throughout the incident.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max({__name__=~\"process_cpu_utilization.*\",service_name=\"checkout\"})",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Checkout memory",
      "description": "Resident memory for the checkout service. Normal throughout the incident.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"process_memory_usage.*\",service_name=\"checkout\",state=\"rss\"})",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Business outcome over time",
      "description": "Healthy traffic shows one line. Incident traffic adds a second.",
      "gridPos": {
        "h": 9,
        "w": 13,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (checkout_outcome) (rate({__name__=~\"checkout_completed.*\"}[15s]))",
          "legendFormat": "{{checkout_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "payment_rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Checkout outcomes by segment",
      "description": "Cumulative count of every currency and discount combination that has run, split by business outcome. Reading the counter directly avoids rate extrapolation, so these are exact whole checkouts.",
      "gridPos": {
        "h": 9,
        "w": 11,
        "x": 13,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (checkout_currency, checkout_discounted, checkout_outcome) ({__name__=~\"checkout_completed.*\"})",
          "legendFormat": "{{checkout_currency}} discounted={{checkout_discounted}} \u2192 {{checkout_outcome}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*payment_rejected.*"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "valueMode": "text",
        "namePlacement": "top",
        "text": {
          "titleSize": 13,
          "valueSize": 30
        }
      }
    }
  ]
}
