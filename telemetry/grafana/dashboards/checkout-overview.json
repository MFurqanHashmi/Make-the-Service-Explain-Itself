  "panels": [
    {
      "type": "text",
      "title": "Question",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## Host metrics are normal and every request is HTTP 200. Is checkout healthy?\nThe business outcome metric added in this checkpoint answers that question."
      }
    },
    {
      "type": "stat",
      "title": "HTTP 200 responses",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate({__name__=~\"checkout_http_responses.*\",http_response_status_code=\"200\"}[15s])) / sum(rate({__name__=~\"checkout_http_responses.*\"}[15s]))",
          "legendFormat": "HTTP 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Business failure rate",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate({__name__=~\"checkout_completed.*\",checkout_outcome!=\"success\"}[15s])) / sum(rate({__name__=~\"checkout_completed.*\"}[15s]))",
          "legendFormat": "Business failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Checkout CPU",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max({__name__=~\"process_cpu_utilization.*\",service_name=\"checkout\"})",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Checkout memory",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"process_memory_usage.*\",service_name=\"checkout\",state=\"rss\"})",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 268435456
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Business outcome over time",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (checkout_outcome) (rate({__name__=~\"checkout_completed.*\"}[15s]))",
          "legendFormat": "{{checkout_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 18,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Failures by segment",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (checkout_currency, checkout_discounted) (increase({__name__=~\"checkout_completed.*\",checkout_outcome!=\"success\"}[2m]))",
          "legendFormat": "{{checkout_currency}} \u00b7 discounted={{checkout_discounted}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizWidth": 10,
        "minVizHeight": 16
      }
